[Unit]
Description=Show the Tiny Hat shutdown animation
DefaultDependencies=no
Before=systemd-poweroff.service systemd-reboot.service systemd-halt.service
ConditionKernelCommandLine=quiet

[Service]
Type=forking
ExecStart=@/usr/bin/tinyhat-splash @tinyhat-splash --shutdown /var/lib/tinyhat-bootsplash/active

[Install]
WantedBy=poweroff.target reboot.target halt.target
