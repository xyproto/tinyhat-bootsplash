#!/usr/bin/ash

run_hook() {
    grep -qw quiet /proc/cmdline || return 0
    i=0
    while [ ! -c /dev/fb0 ] && [ "$i" -lt 20 ]; do
        sleep 0.1
        i=$((i + 1))
    done
    [ -c /dev/fb0 ] || return 0
    /usr/bin/tinyhat-splash
    if [ -x /usr/lib/tinyhat-bootsplash/active ] && [ -p /run/tinyhat-splash ]; then
        echo "hat / /usr/lib/tinyhat-bootsplash/active" >/run/tinyhat-splash
    fi
}
